{
  "name": "quickquit",
  "version": "1.0.0",
  "description": "A tiny native macOS utility that asks your open Dock apps to quit with Control+Shift+Q. Never force-quits.",
  "keywords": [
    "macos",
    "swift",
    "productivity",
    "keyboard-shortcut",
    "quit",
    "utility"
  ],
  "homepage": "https://github.com/choudharyjayesh668/QuickQuit#readme",
  "bugs": {
    "url": "https://github.com/choudharyjayesh668/QuickQuit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/choudharyjayesh668/QuickQuit.git"
  },
  "license": "MIT",
  "author": "Jayesh Choudhary (https://github.com/choudharyjayesh668)",
  "os": [
    "darwin"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "quickquit": "bin/quickquit.js"
  },
  "files": [
    "bin/",
    "lib/",
    "scripts/",
    "Sources/",
    "build.sh"
  ],
  "scripts": {
    "build": "./build.sh",
    "test": "npm run test:swift && npm run test:cli",
    "test:swift": "./test.sh",
    "test:cli": "node --test Tests/cli.test.js",
    "postinstall": "node scripts/postinstall.js",
    "prepublishOnly": "npm test"
  }
}
